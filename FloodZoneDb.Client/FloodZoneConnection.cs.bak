using Npgsql;
using System.Globalization;
using System.Text.Json;

namespace FloodZoneDb.Client;

public sealed class FloodZoneConnection
{
    private readonly string _connectionString;

    public FloodZoneConnection(string connectionString)
    {
        if (string.IsNullOrWhiteSpace(connectionString))
            throw new ArgumentException("Строка подключения не задана.", nameof(connectionString));

        _connectionString = connectionString;
    }

    public static FloodZoneConnection FromEnvironment()
    {
        var connectionString = Environment.GetEnvironmentVariable("FLOODZONE_CONN");
        if (string.IsNullOrWhiteSpace(connectionString))
            throw new InvalidOperationException(
                "Переменная окружения FLOODZONE_CONN не задана.");

        return new FloodZoneConnection(connectionString);
    }

    public async Task<bool> CanConnectAsync(CancellationToken cancellationToken = default)
    {
        DatabaseLogger.Info("Проверка подключения к PostgreSQL.");
        try
        {
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("select 1", connection);
            var result = Convert.ToInt32(await command.ExecuteScalarAsync(cancellationToken)) == 1;
            DatabaseLogger.Info("Проверка подключения завершена: " + result + ".");
            return result;
        }
        catch (Exception ex)
        {
            DatabaseLogger.Error("Ошибка проверки подключения к PostgreSQL.", ex);
            throw;
        }
    }

    public async Task EnsureDatabaseAndSchemaAsync(CancellationToken cancellationToken = default)
        {
            var builder = new NpgsqlConnectionStringBuilder(_connectionString);
            if (string.IsNullOrWhiteSpace(builder.Database))
                throw new InvalidOperationException("В строке подключения не указана база данных.");

            var databaseName = builder.Database!;
            builder.Database = "postgres";
            await using (var admin = new NpgsqlConnection(builder.ConnectionString))
            {
                await admin.OpenAsync(cancellationToken);
                using var exists = new NpgsqlCommand(
                    "select 1 from pg_database where datname = @name;", admin);
                exists.Parameters.AddWithValue("name", databaseName);
                if (await exists.ExecuteScalarAsync(cancellationToken) == null)
                {
                    var quoted = "\"" + databaseName.Replace("\"", "\"\"") + "\"";
                    using var create = new NpgsqlCommand("create database " + quoted + ";", admin);
                    await create.ExecuteNonQueryAsync(cancellationToken);
                    DatabaseLogger.Info("База данных создана: " + databaseName + ".");
                }
            }

            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var schema = new NpgsqlCommand(ReadEmbeddedSql(), connection);
            await schema.ExecuteNonQueryAsync(cancellationToken);
            using var extra = new NpgsqlCommand("""
                create table if not exists calculation_data (
                    id bigint generated by default as identity primary key,
                    object_id bigint not null references objects(id) on delete cascade,
                    calc_number character varying(50) not null,
                    source_file text,
                    sections_json jsonb not null,
                    created_at timestamp with time zone not null default now(),
                    updated_at timestamp with time zone not null default now(),
                    constraint uq_calculation_data_object_number unique (object_id, calc_number)
                );
                """, connection);
            await extra.ExecuteNonQueryAsync(cancellationToken);
            using var profile = new NpgsqlCommand("""
                create table if not exists object_profiles (
                    object_id bigint primary key references objects(id) on delete cascade,
                    profile_json jsonb not null,
                    updated_at timestamp with time zone not null default now()
                );
                """, connection);
            await profile.ExecuteNonQueryAsync(cancellationToken);
            using var stageOne = new NpgsqlCommand("""
                create table if not exists technical_characteristics (
                    id bigint generated by default as identity primary key,
                    object_id bigint not null unique references objects(id) on delete cascade,
                    dam_type text, dam_length_m numeric, max_dam_height_m numeric,
                    normal_retaining_level_m numeric, min_water_level_m numeric,
                    reservoir_volume_million_m3 numeric, spillway_type text,
                    max_discharge_m3s numeric, spillway_opening_count integer,
                    turbine_type text, generator_type text, voltage_kv numeric
                );
                create table if not exists calculation_inputs (
                    id bigint generated by default as identity primary key,
                    object_id bigint not null unique references objects(id) on delete cascade,
                    n numeric, reservoir_volume_wv numeric, reservoir_depth_hv numeric,
                    reservoir_area_sv numeric, reservoir_width_bv numeric,
                    lower_reach_depth_hb0 numeric, lower_reach_width_bb0 numeric,
                    lower_reach_velocity_vb0 numeric, break_depth_hr numeric,
                    destruction_degree_er numeric, breach_threshold_p numeric,
                    water_level_zv numeric
                );
                create table if not exists cross_sections (
                    id bigint generated by default as identity primary key,
                    object_id bigint not null references objects(id) on delete cascade,
                    number integer not null, distance_from_hydro_unit_m numeric,
                    bottom_level_zb numeric, depth_hb numeric, width_bb numeric,
                    velocity_vb numeric, kgm numeric, left_bank_height_m numeric,
                    left_floodplain_width_m numeric, right_bank_height_m numeric,
                    right_floodplain_width_m numeric,
                    constraint uq_cross_sections_object_number unique (object_id, number)
                );
                create table if not exists bank_points (
                    id bigint generated by default as identity primary key,
                    cross_section_id bigint not null references cross_sections(id) on delete cascade,
                    side text not null check (side in ('Left', 'Center', 'Right')),
                    point_type text not null check (point_type in ('Bank', 'Horizontal', 'ChannelBank', 'Bottom')),
                    point_number integer not null, distance_m numeric, elevation_m numeric
                );
                """, connection);
            await stageOne.ExecuteNonQueryAsync(cancellationToken);
            using var pointConstraints = new NpgsqlCommand("""
                do $$
                declare constraint_name text;
                begin
                    for constraint_name in
                        select con.conname
                        from pg_constraint con
                        where con.conrelid = 'bank_points'::regclass
                          and con.contype = 'c'
                          and (
                              pg_get_constraintdef(con.oid) ilike '%side%'
                              or pg_get_constraintdef(con.oid) ilike '%point_type%'
                          )
                    loop
                        execute format('alter table bank_points drop constraint %I', constraint_name);
                    end loop;
                end $$;
                alter table bank_points
                    add constraint bank_points_side_check
                    check (side in ('Left', 'Center', 'Right'));
                alter table bank_points
                    add constraint bank_points_point_type_check
                    check (point_type in ('Bank', 'Horizontal', 'ChannelBank', 'Bottom'));
                """, connection);
            await pointConstraints.ExecuteNonQueryAsync(cancellationToken);
            using var results = new NpgsqlCommand("""
                create table if not exists calc_main_results (
                    calculation_id bigint primary key references calculations(id) on delete cascade,
                    throughput_m3s numeric,
                    max_flow_m3s numeric,
                    min_flow_m3s numeric,
                    avg_velocity_ms numeric,
                    upstream_level_m numeric,
                    downstream_level_m numeric,
                    efficiency_pct numeric,
                    annual_generation_mkwh numeric,
                    reliability_coeff numeric
                );
                """, connection);
            await results.ExecuteNonQueryAsync(cancellationToken);
            using var seed = new NpgsqlCommand("""
                insert into object_types (code, name)
                values ('hydro_node', 'Гидроузел')
                on conflict (code) do nothing;
                """, connection);
            await seed.ExecuteNonQueryAsync(cancellationToken);
            DatabaseLogger.Info("Миграции и служебная схема применены.");
        }

        public async Task SaveCalculationAsync(long objectId, string sectionsJson,
            string sourceFile,
            IReadOnlyList<(decimal ProvisionPct, decimal FlowM3s)> provision,
            IReadOnlyList<(string UseCategory, decimal SharePct)> balance,
            IReadOnlyList<(short MonthNum, decimal GenerationMkwh)> generation,
            CancellationToken cancellationToken = default)
        {
            if (string.IsNullOrWhiteSpace(sectionsJson))
                throw new InvalidOperationException("Нельзя сохранить расчёт без створов.");

            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("""
                insert into calculation_data (object_id, calc_number, source_file, sections_json)
                values (@object_id, 'flood-zone', @source_file, cast(@sections_json as jsonb))
                on conflict (object_id, calc_number) do update set
                    source_file = excluded.source_file,
                    sections_json = excluded.sections_json,
                    updated_at = now();
                """, connection);
            command.Parameters.AddWithValue("object_id", objectId);
            command.Parameters.AddWithValue("source_file", (object)sourceFile ?? DBNull.Value);
            command.Parameters.AddWithValue("sections_json", sectionsJson);
            await command.ExecuteNonQueryAsync(cancellationToken);
            using var calculation = new NpgsqlCommand("""
                insert into calculations (object_id, calc_number, name, mode, status, performed_at)
                values (@object_id, 'flood-zone', 'Расчёт зоны затопления', 'Просмотр', 1, now())
                on conflict (object_id, calc_number) do update set performed_at = now()
                returning id;
                """, connection);
            calculation.Parameters.AddWithValue("object_id", objectId);
            var calculationId = Convert.ToInt64(await calculation.ExecuteScalarAsync(cancellationToken));
            var sections = JsonSerializer.Deserialize<List<CalculationSection>>(sectionsJson)
                ?? new List<CalculationSection>();
            var maxFlow = sections.Count == 0 ? 0 : sections.Max(x => x.MaxDepth);
            var minFlow = sections.Count == 0 ? 0 : sections.Min(x => x.MaxDepth);
            var avgVelocity = sections.Count == 0 ? 0 : sections.Average(x => x.MaxVelocity);
            var upstream = sections.Count == 0 ? 0 : sections.Max(x => x.WaterLevel);
            using var result = new NpgsqlCommand("""
                insert into calc_main_results
                    (calculation_id, throughput_m3s, max_flow_m3s, min_flow_m3s,
                     avg_velocity_ms, upstream_level_m, downstream_level_m,
                     efficiency_pct, annual_generation_mkwh, reliability_coeff)
                values (@id, @throughput, @max_flow, @min_flow, @velocity,
                        @upstream, @downstream, 0, 0, 0)
                on conflict (calculation_id) do update set
                    throughput_m3s = excluded.throughput_m3s,
                    max_flow_m3s = excluded.max_flow_m3s,
                    min_flow_m3s = excluded.min_flow_m3s,
                    avg_velocity_ms = excluded.avg_velocity_ms,
                    upstream_level_m = excluded.upstream_level_m;
                """, connection);
            result.Parameters.AddWithValue("id", calculationId);
            result.Parameters.AddWithValue("throughput", sections.Sum(x => x.FloodWidthLeft + x.FloodWidthRight));
            result.Parameters.AddWithValue("max_flow", maxFlow);
            result.Parameters.AddWithValue("min_flow", minFlow);
            result.Parameters.AddWithValue("velocity", avgVelocity);
            result.Parameters.AddWithValue("upstream", upstream);
            result.Parameters.AddWithValue("downstream", sections.Count == 0 ? 0 : sections.Min(x => x.WaterLevel));
            await result.ExecuteNonQueryAsync(cancellationToken);
            await SaveCalculationDetailsAsync(calculationId, provision ?? Array.Empty<(decimal, decimal)>(),
                balance ?? Array.Empty<(string, decimal)>(),
                generation ?? Array.Empty<(short, decimal)>(), cancellationToken);
            DatabaseLogger.Info("Расчёт сохранён. Объект ID: " + objectId + ".");
        }

        private sealed class CalculationSection
        {
            public double WaterLevel { get; set; }
            public double MaxDepth { get; set; }
            public double MaxVelocity { get; set; }
            public double FloodWidthLeft { get; set; }
            public double FloodWidthRight { get; set; }
        }

        public async Task<SavedCalculation?> LoadCalculationAsync(long objectId,
            CancellationToken cancellationToken = default)
        {
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("""
                select source_file, sections_json
                from calculation_data
                where object_id = @object_id and calc_number = 'flood-zone'
                limit 1;
                """, connection);
            command.Parameters.AddWithValue("object_id", objectId);
            await using var reader = await command.ExecuteReaderAsync(cancellationToken);
            if (!await reader.ReadAsync(cancellationToken))
                return null;
            var source = reader.IsDBNull(0) ? "" : reader.GetString(0);
            return new SavedCalculation(reader.GetString(1), source);
        }

        private static string ReadEmbeddedSql()
        {
            var assembly = typeof(FloodZoneConnection).Assembly;
            using var stream = assembly.GetManifestResourceStream("FloodZoneDb.Migrations.InitialCreate.sql")
                ?? throw new InvalidOperationException("В сборку не включён SQL миграции.");
            using var reader = new StreamReader(stream);
            return reader.ReadToEnd();
        }
        public sealed class SavedCalculation
        {
            public SavedCalculation(string sectionsJson, string sourceFile)
            {
                SectionsJson = sectionsJson;
                SourceFile = sourceFile;
            }

            public string SectionsJson { get; }
            public string SourceFile { get; }
        }

    public async Task<IReadOnlyList<DatabaseObject>> LoadObjectsAsync(
        CancellationToken cancellationToken = default)
    {
        const string sql = """
            select o.id, o.parent_id, ot.code, ot.name, o.name, o.sort_order,
                   o.is_active, o.updated_at
            from objects o
            inner join object_types ot on ot.id = o.object_type_id
            where o.is_active = true
            order by ot.name, o.sort_order, o.name;
            """;

        try
        {
            var result = new List<DatabaseObject>();
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand(sql, connection);
            using var reader = await command.ExecuteReaderAsync(cancellationToken);
            while (await reader.ReadAsync(cancellationToken))
            {
                result.Add(new DatabaseObject
                {
                    Id = reader.GetInt64(0),
                    ParentId = reader.IsDBNull(1) ? null : reader.GetInt64(1),
                    TypeCode = reader.GetString(2),
                    TypeName = reader.GetString(3),
                    Name = reader.GetString(4),
                    SortOrder = reader.GetInt32(5),
                    IsActive = reader.GetBoolean(6),
                    UpdatedAt = reader.GetDateTime(7)
                });
            }

            DatabaseLogger.Info("Загружено объектов из PostgreSQL: " + result.Count + ".");
            return result;
        }
        catch (Exception ex)
        {
            DatabaseLogger.Error("Ошибка загрузки объектов из PostgreSQL.", ex);
            throw;
        }
    }

    public async Task<long> CreateObjectAsync(
        string typeCode,
        string name,
        CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(typeCode))
            throw new ArgumentException("Тип объекта не задан.", nameof(typeCode));
        if (string.IsNullOrWhiteSpace(name))
            throw new ArgumentException("Наименование объекта не задано.", nameof(name));

        const string sql = """
            insert into objects (object_type_id, name, sort_order, is_active, created_at, updated_at)
            select id, @name, coalesce((select max(sort_order) + 1 from objects), 0), true, now(), now()
            from object_types
            where code = @type_code
            returning id;
            """;

        try
        {
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand(sql, connection);
            command.Parameters.AddWithValue("type_code", typeCode);
            command.Parameters.AddWithValue("name", name);
            var result = await command.ExecuteScalarAsync(cancellationToken);
            if (result == null || result == DBNull.Value)
                throw new InvalidOperationException($"Тип объекта '{typeCode}' не найден в справочнике.");
            var id = Convert.ToInt64(result);
            DatabaseLogger.Info("Объект сохранён в PostgreSQL. ID: " + id + ".");
            return id;
        }

        catch (Exception ex)
        {
            DatabaseLogger.Error("Ошибка создания объекта в PostgreSQL. Тип: " + typeCode + ".", ex);
            throw;
        }
    }

    public async Task EnsureObjectTypeAsync(
        string code,
        string name,
        CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(code))
            throw new ArgumentException("Тип объекта не задан.", nameof(code));

        await using var connection = new NpgsqlConnection(_connectionString);
        await connection.OpenAsync(cancellationToken);
        using var command = new NpgsqlCommand("""
            insert into object_types (code, name)
            values (@code, @name)
            on conflict (code) do update set name = excluded.name;
            """, connection);
        command.Parameters.AddWithValue("code", code.Trim());
        command.Parameters.AddWithValue("name", string.IsNullOrWhiteSpace(name) ? code.Trim() : name.Trim());
        await command.ExecuteNonQueryAsync(cancellationToken);
    }

    public async Task DeleteObjectTypeAsync(
        string code,
        CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(code))
            throw new ArgumentException("Тип объекта не задан.", nameof(code));

        await using var connection = new NpgsqlConnection(_connectionString);
        await connection.OpenAsync(cancellationToken);
        using var command = new NpgsqlCommand("""
            delete from object_types t
            where t.code = @code
              and not exists (select 1 from objects o where o.object_type_id = t.id)
            returning t.id;
            """, connection);
        command.Parameters.AddWithValue("code", code.Trim());
        if (await command.ExecuteScalarAsync(cancellationToken) == null)
            throw new InvalidOperationException("Тип используется объектами или не найден.");
    }

    public async Task DeleteObjectAsync(
        long objectId,
        CancellationToken cancellationToken = default)
    {
        if (objectId <= 0)
            throw new ArgumentOutOfRangeException(nameof(objectId));

        try
        {
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand(
                "delete from objects where id = @object_id returning id;", connection);
            command.Parameters.AddWithValue("object_id", objectId);
            var deleted = await command.ExecuteScalarAsync(cancellationToken);
            if (deleted == null || deleted == DBNull.Value)
                throw new InvalidOperationException("Выбранный объект не найден.");

            DatabaseLogger.Info("Объект удалён из PostgreSQL. ID: " + objectId + ".");
        }
        catch (Exception ex)
        {
            DatabaseLogger.Error("Ошибка удаления объекта из PostgreSQL. ID: " + objectId + ".", ex);
            throw;
        }
    }

    public async Task UpdateObjectAsync(
            long objectId, string typeCode, string name,
            CancellationToken cancellationToken = default)
        {
            if (objectId <= 0)
                throw new ArgumentOutOfRangeException(nameof(objectId));
            if (string.IsNullOrWhiteSpace(typeCode))
                throw new ArgumentException("Тип объекта не задан.", nameof(typeCode));
            if (string.IsNullOrWhiteSpace(name))
                throw new ArgumentException("Наименование объекта не задано.", nameof(name));

            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("""
                update objects
                set object_type_id = (select id from object_types where code = @type_code),
                    name = @name,
                    updated_at = now()
                where id = @object_id;
                """, connection);
            command.Parameters.AddWithValue("object_id", objectId);
            command.Parameters.AddWithValue("type_code", typeCode);
            command.Parameters.AddWithValue("name", name);
            if (await command.ExecuteNonQueryAsync(cancellationToken) == 0)
                throw new InvalidOperationException("Выбранный объект не найден.");
            DatabaseLogger.Info("Карточка объекта обновлена. ID: " + objectId + ".");
        }
        

        public async Task<ObjectProfile?> LoadObjectProfileAsync(
            long objectId, CancellationToken cancellationToken = default)
        {
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand(
                "select profile_json from object_profiles where object_id = @object_id;", connection);
            command.Parameters.AddWithValue("object_id", objectId);
            var value = await command.ExecuteScalarAsync(cancellationToken);
            var exists = value != null && value != DBNull.Value;
            var profile = exists
                ? JsonSerializer.Deserialize<ObjectProfile>(Convert.ToString(value)!) ?? new ObjectProfile()
                : new ObjectProfile();
            await LoadNormalizedProfileAsync(connection, objectId, profile, cancellationToken);
            if (exists) return profile;

            using var objectCommand = new NpgsqlCommand("select 1 from objects where id = @object_id;", connection);
            objectCommand.Parameters.AddWithValue("object_id", objectId);
            return await objectCommand.ExecuteScalarAsync(cancellationToken) == null ? null : profile;
        }

        public async Task SaveObjectProfileAsync(
            long objectId, ObjectProfile profile, CancellationToken cancellationToken = default)
        {
            if (objectId <= 0)
                throw new ArgumentOutOfRangeException(nameof(objectId));
            if (profile == null)
                throw new ArgumentNullException(nameof(profile));

            var json = JsonSerializer.Serialize(profile);
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("""
                insert into object_profiles (object_id, profile_json, updated_at)
                values (@object_id, cast(@profile_json as jsonb), now())
                on conflict (object_id) do update set
                    profile_json = excluded.profile_json,
                    updated_at = now();
                """, connection);
            command.Parameters.AddWithValue("object_id", objectId);
            command.Parameters.AddWithValue("profile_json", json);
            await command.ExecuteNonQueryAsync(cancellationToken);
            await SaveNormalizedProfileAsync(connection, objectId, profile, cancellationToken);
            DatabaseLogger.Info("Профиль объекта сохранён. ID: " + objectId + ".");
        }

        private static async Task LoadNormalizedProfileAsync(NpgsqlConnection connection, long objectId,
            ObjectProfile profile, CancellationToken cancellationToken)
        {
            using var technical = new NpgsqlCommand("""
                select dam_type, dam_length_m, max_dam_height_m, normal_retaining_level_m,
                       min_water_level_m, reservoir_volume_million_m3, spillway_type,
                       max_discharge_m3s, spillway_opening_count, turbine_type, generator_type, voltage_kv
                from technical_characteristics where object_id = @id;
                """, connection);
            technical.Parameters.AddWithValue("id", objectId);
            await using (var reader = await technical.ExecuteReaderAsync(cancellationToken))
            {
                if (await reader.ReadAsync(cancellationToken))
                {
                    profile.DamType = Text(reader, 0); profile.DamLengthM = Text(reader, 1);
                    profile.DamMaxHeightM = Text(reader, 2); profile.NormalHeadwaterM = Text(reader, 3);
                    profile.MinWaterLevelM = Text(reader, 4); profile.ReservoirVolumeMlnM3 = Text(reader, 5);
                    profile.SpillwayType = Text(reader, 6); profile.SpillwayCapacityM3s = Text(reader, 7);
                    profile.SpillwayOpeningsCount = Text(reader, 8); profile.TurbineType = Text(reader, 9);
                    profile.GeneratorType = Text(reader, 10); profile.VoltageKv = Text(reader, 11);
                }
            }
            using var inputs = new NpgsqlCommand("""
                select n, reservoir_volume_wv, reservoir_depth_hv, reservoir_area_sv, reservoir_width_bv,
                       lower_reach_depth_hb0, lower_reach_width_bb0, lower_reach_velocity_vb0,
                       break_depth_hr, destruction_degree_er, breach_threshold_p, water_level_zv
                from calculation_inputs where object_id = @id;
                """, connection);
            inputs.Parameters.AddWithValue("id", objectId);
            await using var inputReader = await inputs.ExecuteReaderAsync(cancellationToken);
            if (await inputReader.ReadAsync(cancellationToken))
            {
                profile.CalculationInputs = new CalculationInput
                {
                    N = Text(inputReader, 0), ReservoirVolumeWv = Text(inputReader, 1),
                    ReservoirDepthHv = Text(inputReader, 2), ReservoirAreaSv = Text(inputReader, 3),
                    ReservoirWidthBv = Text(inputReader, 4), LowerReachDepthHb0 = Text(inputReader, 5),
                    LowerReachWidthBb0 = Text(inputReader, 6), LowerReachVelocityVb0 = Text(inputReader, 7),
                    BreakDepthHr = Text(inputReader, 8), DestructionDegreeEr = Text(inputReader, 9),
                    BreachThresholdP = Text(inputReader, 10), WaterLevelZv = Text(inputReader, 11)
                };
            }
        }

        private static async Task SaveNormalizedProfileAsync(NpgsqlConnection connection, long objectId,
            ObjectProfile profile, CancellationToken cancellationToken)
        {
            using var technical = new NpgsqlCommand("""
                insert into technical_characteristics
                    (object_id, dam_type, dam_length_m, max_dam_height_m, normal_retaining_level_m,
                     min_water_level_m, reservoir_volume_million_m3, spillway_type, max_discharge_m3s,
                     spillway_opening_count, turbine_type, generator_type, voltage_kv)
                values (@id,@dam_type,@dam_length,@max_height,@npu,@min_level,@volume,@spillway,@discharge,
                        @openings,@turbine,@generator,@voltage)
                on conflict (object_id) do update set dam_type=excluded.dam_type, dam_length_m=excluded.dam_length_m,
                    max_dam_height_m=excluded.max_dam_height_m, normal_retaining_level_m=excluded.normal_retaining_level_m,
                    min_water_level_m=excluded.min_water_level_m, reservoir_volume_million_m3=excluded.reservoir_volume_million_m3,
                    spillway_type=excluded.spillway_type, max_discharge_m3s=excluded.max_discharge_m3s,
                    spillway_opening_count=excluded.spillway_opening_count, turbine_type=excluded.turbine_type,
                    generator_type=excluded.generator_type, voltage_kv=excluded.voltage_kv;
                """, connection);
            technical.Parameters.AddWithValue("id", objectId);
            technical.Parameters.AddWithValue("dam_type", DbText(profile.DamType));
            technical.Parameters.AddWithValue("dam_length", Db(profile.DamLengthM)); technical.Parameters.AddWithValue("max_height", Db(profile.DamMaxHeightM));
            technical.Parameters.AddWithValue("npu", Db(profile.NormalHeadwaterM)); technical.Parameters.AddWithValue("min_level", Db(profile.MinWaterLevelM));
            technical.Parameters.AddWithValue("volume", Db(profile.ReservoirVolumeMlnM3));             technical.Parameters.AddWithValue("spillway", DbText(profile.SpillwayType));
            technical.Parameters.AddWithValue("discharge", Db(profile.SpillwayCapacityM3s)); technical.Parameters.AddWithValue("openings", DbInt(profile.SpillwayOpeningsCount));
            technical.Parameters.AddWithValue("turbine", DbText(profile.TurbineType)); technical.Parameters.AddWithValue("generator", DbText(profile.GeneratorType)); technical.Parameters.AddWithValue("voltage", Db(profile.VoltageKv));
            await technical.ExecuteNonQueryAsync(cancellationToken);
            var i = profile.CalculationInputs ?? new CalculationInput();
            using var inputs = new NpgsqlCommand("""
                insert into calculation_inputs
                    (object_id,n,reservoir_volume_wv,reservoir_depth_hv,reservoir_area_sv,reservoir_width_bv,
                     lower_reach_depth_hb0,lower_reach_width_bb0,lower_reach_velocity_vb0,break_depth_hr,
                     destruction_degree_er,breach_threshold_p,water_level_zv)
                values (@id,@n,@wv,@hv,@sv,@bv,@hb0,@bb0,@vb0,@hr,@er,@p,@zv)
                on conflict (object_id) do update set n=excluded.n,reservoir_volume_wv=excluded.reservoir_volume_wv,
                    reservoir_depth_hv=excluded.reservoir_depth_hv,reservoir_area_sv=excluded.reservoir_area_sv,
                    reservoir_width_bv=excluded.reservoir_width_bv,lower_reach_depth_hb0=excluded.lower_reach_depth_hb0,
                    lower_reach_width_bb0=excluded.lower_reach_width_bb0,lower_reach_velocity_vb0=excluded.lower_reach_velocity_vb0,
                    break_depth_hr=excluded.break_depth_hr,destruction_degree_er=excluded.destruction_degree_er,
                    breach_threshold_p=excluded.breach_threshold_p,water_level_zv=excluded.water_level_zv;
                """, connection);
            inputs.Parameters.AddWithValue("id", objectId);
            inputs.Parameters.AddWithValue("n", Db(i.N)); inputs.Parameters.AddWithValue("wv", Db(i.ReservoirVolumeWv)); inputs.Parameters.AddWithValue("hv", Db(i.ReservoirDepthHv));
            inputs.Parameters.AddWithValue("sv", Db(i.ReservoirAreaSv)); inputs.Parameters.AddWithValue("bv", Db(i.ReservoirWidthBv)); inputs.Parameters.AddWithValue("hb0", Db(i.LowerReachDepthHb0));
            inputs.Parameters.AddWithValue("bb0", Db(i.LowerReachWidthBb0)); inputs.Parameters.AddWithValue("vb0", Db(i.LowerReachVelocityVb0)); inputs.Parameters.AddWithValue("hr", Db(i.BreakDepthHr));
            inputs.Parameters.AddWithValue("er", Db(i.DestructionDegreeEr)); inputs.Parameters.AddWithValue("p", Db(i.BreachThresholdP)); inputs.Parameters.AddWithValue("zv", Db(i.WaterLevelZv));
            await inputs.ExecuteNonQueryAsync(cancellationToken);
        }

        private static string Text(NpgsqlDataReader reader, int ordinal) =>
            reader.IsDBNull(ordinal) ? "" : Convert.ToString(reader.GetValue(ordinal), CultureInfo.InvariantCulture) ?? "";

        private static object Db(string value) => decimal.TryParse(value?.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var number) ? number : DBNull.Value;
        private static object DbText(string value) => string.IsNullOrWhiteSpace(value) ? DBNull.Value : value.Trim();
        private static object DbInt(string value) => int.TryParse(value, out var number) ? number : DBNull.Value;

        public async Task<IReadOnlyList<CrossSectionRecord>> LoadCrossSectionsAsync(long objectId,
            CancellationToken cancellationToken = default)
        {
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("""
                select id, number, distance_from_hydro_unit_m, bottom_level_zb, depth_hb, width_bb,
                       velocity_vb, kgm, left_bank_height_m, left_floodplain_width_m,
                       right_bank_height_m, right_floodplain_width_m
                from cross_sections where object_id = @id order by number;
                """, connection);
            command.Parameters.AddWithValue("id", objectId);
            var result = new List<CrossSectionRecord>();
            await using (var reader = await command.ExecuteReaderAsync(cancellationToken))
            {
                while (await reader.ReadAsync(cancellationToken))
                    result.Add(new CrossSectionRecord
                    {
                        Id = reader.GetInt64(0), ObjectId = objectId, Number = reader.GetInt32(1),
                        DistanceFromHydroUnitM = Text(reader, 2), BottomLevelZb = Text(reader, 3),
                        DepthHb = Text(reader, 4), WidthBb = Text(reader, 5), VelocityVb = Text(reader, 6),
                        Kgm = Text(reader, 7), LeftBankHeightM = Text(reader, 8),
                        LeftFloodplainWidthM = Text(reader, 9), RightBankHeightM = Text(reader, 10),
                        RightFloodplainWidthM = Text(reader, 11)
                    });
            }
            foreach (var section in result)
                await LoadBankPointsAsync(connection, section, cancellationToken);
            return result;
        }

        private static async Task LoadBankPointsAsync(NpgsqlConnection connection, CrossSectionRecord section,
            CancellationToken cancellationToken)
        {
            using var command = new NpgsqlCommand("""
                select id, side, point_type, point_number, distance_m, elevation_m
                from bank_points where cross_section_id = @id order by side, point_number;
                """, connection);
            command.Parameters.AddWithValue("id", section.Id);
            await using var reader = await command.ExecuteReaderAsync(cancellationToken);
            while (await reader.ReadAsync(cancellationToken))
                section.BankPoints.Add(new BankPointRecord
                {
                    Id = reader.GetInt64(0), CrossSectionId = section.Id, Side = reader.GetString(1),
                    PointType = reader.GetString(2), PointNumber = reader.GetInt32(3),
                    DistanceM = Text(reader, 4), ElevationM = Text(reader, 5)
                });
        }

        public async Task<long> SaveCrossSectionAsync(CrossSectionRecord section,
            CancellationToken cancellationToken = default)
        {
            if (section.ObjectId <= 0 || section.Number <= 0)
                throw new ArgumentException("Объект и номер створа обязательны.");
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("""
                insert into cross_sections
                    (object_id, number, distance_from_hydro_unit_m, bottom_level_zb, depth_hb, width_bb,
                     velocity_vb, kgm, left_bank_height_m, left_floodplain_width_m,
                     right_bank_height_m, right_floodplain_width_m)
                values (@object,@number,@distance,@bottom,@depth,@width,@velocity,@kgm,@lh,@lf,@rh,@rf)
                on conflict (object_id, number) do update set
                    distance_from_hydro_unit_m=excluded.distance_from_hydro_unit_m,
                    bottom_level_zb=excluded.bottom_level_zb, depth_hb=excluded.depth_hb,
                    width_bb=excluded.width_bb, velocity_vb=excluded.velocity_vb, kgm=excluded.kgm,
                    left_bank_height_m=excluded.left_bank_height_m, left_floodplain_width_m=excluded.left_floodplain_width_m,
                    right_bank_height_m=excluded.right_bank_height_m, right_floodplain_width_m=excluded.right_floodplain_width_m
                returning id;
                """, connection);
            command.Parameters.AddWithValue("object", section.ObjectId); command.Parameters.AddWithValue("number", section.Number);
            command.Parameters.AddWithValue("distance", Db(section.DistanceFromHydroUnitM)); command.Parameters.AddWithValue("bottom", Db(section.BottomLevelZb));
            command.Parameters.AddWithValue("depth", Db(section.DepthHb)); command.Parameters.AddWithValue("width", Db(section.WidthBb));
            command.Parameters.AddWithValue("velocity", Db(section.VelocityVb)); command.Parameters.AddWithValue("kgm", Db(section.Kgm));
            command.Parameters.AddWithValue("lh", Db(section.LeftBankHeightM)); command.Parameters.AddWithValue("lf", Db(section.LeftFloodplainWidthM));
            command.Parameters.AddWithValue("rh", Db(section.RightBankHeightM)); command.Parameters.AddWithValue("rf", Db(section.RightFloodplainWidthM));
            var id = Convert.ToInt64(await command.ExecuteScalarAsync(cancellationToken));
            using var delete = new NpgsqlCommand("delete from bank_points where cross_section_id = @id;", connection);
            delete.Parameters.AddWithValue("id", id);
            await delete.ExecuteNonQueryAsync(cancellationToken);
            foreach (var point in section.BankPoints)
            {
                using var insert = new NpgsqlCommand("""
                    insert into bank_points
                        (cross_section_id, side, point_type, point_number, distance_m, elevation_m)
                    values (@id,@side,@type,@number,@distance,@elevation);
                    """, connection);
                insert.Parameters.AddWithValue("id", id); insert.Parameters.AddWithValue("side", point.Side);
                insert.Parameters.AddWithValue("type", point.PointType); insert.Parameters.AddWithValue("number", point.PointNumber);
                insert.Parameters.AddWithValue("distance", Db(point.DistanceM)); insert.Parameters.AddWithValue("elevation", Db(point.ElevationM));
                await insert.ExecuteNonQueryAsync(cancellationToken);
            }
            return id;
        }

        public async Task DeleteCrossSectionAsync(long sectionId, CancellationToken cancellationToken = default)
        {
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("delete from cross_sections where id = @id;", connection);
            command.Parameters.AddWithValue("id", sectionId);
            await command.ExecuteNonQueryAsync(cancellationToken);
        }

        public async Task DeleteBankPointAsync(long pointId, CancellationToken cancellationToken = default)
        {
            if (pointId <= 0)
                throw new ArgumentOutOfRangeException(nameof(pointId));

            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("delete from bank_points where id = @id;", connection);
            command.Parameters.AddWithValue("id", pointId);
            await command.ExecuteNonQueryAsync(cancellationToken);
        }

        // ---------------------------------------------------------------
        // Расчётные данные: изодаты расходов / баланс водопользования / выработка
        // ---------------------------------------------------------------

        public async Task<IReadOnlyList<(decimal ProvisionPct, decimal FlowM3s)>> LoadFlowProvisionAsync(
            long objectId, CancellationToken cancellationToken = default)
        {
            var result = new List<(decimal, decimal)>();
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("""
                select fp.provision_pct, fp.flow_m3s
                from calc_flow_provision fp
                inner join calculations c on c.id = fp.calculation_id
                where c.object_id = @object_id
                order by fp.provision_pct
                """, connection);
            command.Parameters.AddWithValue("object_id", objectId);
            await using var reader = await command.ExecuteReaderAsync(cancellationToken);
            while (await reader.ReadAsync(cancellationToken))
            {
                result.Add((
                    reader.IsDBNull(0) ? 0m : Convert.ToDecimal(reader.GetValue(0)),
                    reader.IsDBNull(1) ? 0m : Convert.ToDecimal(reader.GetValue(1))));
            }
            return result;
        }

        public async Task<IReadOnlyList<(string UseCategory, decimal SharePct)>> LoadWaterBalanceAsync(
            long objectId, CancellationToken cancellationToken = default)
        {
            var result = new List<(string, decimal)>();
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("""
                select wb.use_category, wb.share_pct
                from calc_water_balance wb
                inner join calculations c on c.id = wb.calculation_id
                where c.object_id = @object_id
                order by wb.use_category
                """, connection);
            command.Parameters.AddWithValue("object_id", objectId);
            await using var reader = await command.ExecuteReaderAsync(cancellationToken);
            while (await reader.ReadAsync(cancellationToken))
            {
                result.Add((
                    reader.IsDBNull(0) ? "" : Convert.ToString(reader.GetValue(0))!,
                    reader.IsDBNull(1) ? 0m : Convert.ToDecimal(reader.GetValue(1))));
            }
            return result;
        }

        public async Task<IReadOnlyList<(short MonthNum, decimal GenerationMkwh)>> LoadPowerGenerationAsync(
            long objectId, CancellationToken cancellationToken = default)
        {
            var result = new List<(short, decimal)>();
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);
            using var command = new NpgsqlCommand("""
                select pg.month_num, pg.generation_mkwh
                from calc_power_generation pg
                inner join calculations c on c.id = pg.calculation_id
                where c.object_id = @object_id
                order by pg.month_num
                """, connection);
            command.Parameters.AddWithValue("object_id", objectId);
            await using var reader = await command.ExecuteReaderAsync(cancellationToken);
            while (await reader.ReadAsync(cancellationToken))
            {
                result.Add((
                    reader.IsDBNull(0) ? (short)0 : Convert.ToInt16(reader.GetValue(0)),
                    reader.IsDBNull(1) ? 0m : Convert.ToDecimal(reader.GetValue(1))));
            }
            return result;
        }

        public async Task SaveCalculationDetailsAsync(
            long calculationId,
            IReadOnlyList<(decimal ProvisionPct, decimal FlowM3s)> provision,
            IReadOnlyList<(string UseCategory, decimal SharePct)> balance,
            IReadOnlyList<(short MonthNum, decimal GenerationMkwh)> generation,
            CancellationToken cancellationToken = default)
        {
            await using var connection = new NpgsqlConnection(_connectionString);
            await connection.OpenAsync(cancellationToken);

            using var del1 = new NpgsqlCommand(
                "delete from calc_flow_provision where calculation_id = @id;", connection);
            del1.Parameters.AddWithValue("id", calculationId);
            await del1.ExecuteNonQueryAsync(cancellationToken);
            foreach (var (p, q) in provision)
            {
                using var cmd = new NpgsqlCommand(
                    "insert into calc_flow_provision (calculation_id, provision_pct, flow_m3s) " +
                    "values (@calcId, @p, @q);", connection);
                cmd.Parameters.AddWithValue("calcId", calculationId);
                cmd.Parameters.AddWithValue("p", p);
                cmd.Parameters.AddWithValue("q", q);
                await cmd.ExecuteNonQueryAsync(cancellationToken);
            }

            using var del2 = new NpgsqlCommand(
                "delete from calc_water_balance where calculation_id = @id;", connection);
            del2.Parameters.AddWithValue("id", calculationId);
            await del2.ExecuteNonQueryAsync(cancellationToken);
            foreach (var (cat, share) in balance)
            {
                using var cmd = new NpgsqlCommand(
                    "insert into calc_water_balance (calculation_id, use_category, share_pct) " +
                    "values (@calcId, @cat, @share);", connection);
                cmd.Parameters.AddWithValue("calcId", calculationId);
                cmd.Parameters.AddWithValue("cat", cat);
                cmd.Parameters.AddWithValue("share", share);
                await cmd.ExecuteNonQueryAsync(cancellationToken);
            }

            using var del3 = new NpgsqlCommand(
                "delete from calc_power_generation where calculation_id = @id;", connection);
            del3.Parameters.AddWithValue("id", calculationId);
            await del3.ExecuteNonQueryAsync(cancellationToken);
            foreach (var (month, gen) in generation)
            {
                using var cmd = new NpgsqlCommand(
                    "insert into calc_power_generation (calculation_id, month_num, generation_mkwh) " +
                    "values (@calcId, @month, @gen);", connection);
                cmd.Parameters.AddWithValue("calcId", calculationId);
                cmd.Parameters.AddWithValue("month", month);
                cmd.Parameters.AddWithValue("gen", gen);
                await cmd.ExecuteNonQueryAsync(cancellationToken);
            }
        }

    }
